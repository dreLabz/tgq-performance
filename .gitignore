# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# video — hosted externally, never committed.
# Recursive (**) on purpose: the old root-only patterns missed instruction/
# and shorts/ entirely. The hero loop is the one exception, un-ignored below,
# because it must load instantly and is small enough to ship.
/public/video/**/*.mov
/public/video/**/*.mp4
!/public/video/hero-loop.mp4

# working reference material — mood boards, client raws, comps (never served or committed)
/_reference/
